{
    "name": "kilyscommerce/app",
    "description": "Application e-commerce KilysCommerce en PHP/MySQL",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testdox tests/"
    },
    "minimum-stability": "stable"
}

